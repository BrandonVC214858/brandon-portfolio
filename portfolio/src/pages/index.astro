---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Footer from '../components/Footer.astro';
import { skillGroups } from '../data/skills';

const byOrder = <T extends { data: { order: number } }>(a: T, b: T) =>
  a.data.order - b.data.order;

const experience = (await getCollection('experience')).sort(byOrder);
const projects = (await getCollection('projects')).sort(byOrder);
---

<BaseLayout>
  <Header />
  <main id="main">
    <Hero />

    <SectionHeading index="02" title="Experience" id="experience">
      <div>
        {experience.map((entry) => <ExperienceItem entry={entry} />)}
      </div>
    </SectionHeading>

    <SectionHeading index="03" title="Selected projects" id="projects">
      <div class="projects-grid">
        {projects.map((entry, i) => <ProjectCard entry={entry} index={i} />)}
      </div>
    </SectionHeading>

    <SectionHeading index="04" title="Skills" id="skills">
      <dl class="skills-grid">
        {
          skillGroups.map((group) => (
            <div class="skills-group soul-glow">
              <dt class="skills-label mono-label">{group.label}</dt>
              <dd class="skills-items">
                <ul>
                  {group.items.map((item) => (
                    <li class="tag">{item}</li>
                  ))}
                </ul>
              </dd>
            </div>
          ))
        }
      </dl>
    </SectionHeading>

    <SectionHeading index="05" title="Education" id="education">
      <article class="education">
        <div class="education__dot" aria-hidden="true"></div>
        <p class="mono-label education__dates">Aug 2021 — Expected 2026</p>
        <h3 class="education__degree">B.S. in Software Engineering</h3>
        <p class="education__school">Universidad Autónoma de Ciudad Juárez (UACJ)</p>
        <p class="education__note">
          Thesis: a financial risk compliance engine built with Python, FastAPI and RAG —
          see Selected projects.
        </p>
      </article>
    </SectionHeading>
  </main>
  <Footer />
</BaseLayout>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(20rem, 100%), 1fr));
    gap: 2rem;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
    gap: 1.5rem;
    margin: 0;
  }

  .skills-group {
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    background: var(--surface-container);
  }

  .skills-label {
    color: var(--secondary);
  }

  .skills-items {
    margin: 1rem 0 0;
  }

  .skills-items ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .education {
    position: relative;
    max-width: 42rem;
    margin-inline: auto;
    padding-top: 3rem;
    text-align: center;
  }

  .education::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    height: 2.5rem;
    width: 1px;
    background: linear-gradient(to bottom, rgba(73, 69, 82, 0.6), transparent);
  }

  .education__dot {
    position: absolute;
    left: 50%;
    top: 0;
    transform: translateX(-50%);
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 9999px;
    background: var(--surface);
    border: 2px solid var(--primary);
    box-shadow: 0 0 10px var(--primary);
    z-index: 1;
  }

  .education__dates {
    color: var(--primary);
  }

  .education__degree {
    margin-top: 0.75rem;
    font-size: var(--text-headline-md);
  }

  .education__school {
    margin-top: 0.4rem;
    color: var(--ink-muted);
  }

  .education__note {
    max-width: 50ch;
    margin: 1rem auto 0;
    color: var(--ink-muted);
  }
</style>
