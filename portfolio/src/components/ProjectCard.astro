---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'projects'>;
}

const { name, role, description, highlights, stack, link } = Astro.props.entry.data;
---

<article class="project">
  <p class="mono-label">{role}</p>
  <h3 class="project__name">
    {
      link ? (
        <a href={link} rel="noopener noreferrer" target="_blank">
          {name} ↗
        </a>
      ) : (
        name
      )
    }
  </h3>
  <p class="project__description">{description}</p>
  <ul class="project__highlights">
    {highlights.map((highlight) => <li>{highlight}</li>)}
  </ul>
  <ul class="project__stack" aria-label="Technologies used">
    {stack.map((tech) => <li class="tag">{tech}</li>)}
  </ul>
</article>

<style>
  .project {
    display: flex;
    flex-direction: column;
    padding: 1.75rem;
    border: 1px solid var(--line-strong);
    background: color-mix(in srgb, var(--ink-800) 55%, transparent);
  }

  .project__name {
    margin-top: 0.6rem;
    font-size: var(--text-lg);
  }

  .project__name a {
    color: inherit;
  }

  .project__name a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .project__description {
    margin-top: 0.9rem;
    color: var(--chalk);
  }

  .project__highlights {
    display: grid;
    gap: 0.65rem;
    margin-top: 1.1rem;
    font-size: var(--text-sm);
    color: var(--chalk);
  }

  .project__highlights li {
    position: relative;
    padding-left: 1.1rem;
  }

  .project__highlights li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  .project__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 1.5rem;
  }
</style>
