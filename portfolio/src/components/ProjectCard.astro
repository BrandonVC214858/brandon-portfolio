---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'projects'>;
  /** Position in the grid; shifts the decorative gradient art per card. */
  index?: number;
}

const { entry, index = 0 } = Astro.props;
const { name, role, description, highlights, stack, link } = entry.data;
const artShift = `${(index * 30) % 90}%`;
---

<article class="project soul-glow" style={`--art-shift: ${artShift}`}>
  <div class="project__art" aria-hidden="true"></div>
  <div class="project__body">
    <p class="mono-label">{role}</p>
    <h3 class="project__name">
      {
        link ? (
          <a href={link} rel="noopener noreferrer" target="_blank">
            {name} ↗
          </a>
        ) : (
          name
        )
      }
    </h3>
    <p class="project__description">{description}</p>
    <ul class="project__highlights">
      {highlights.map((highlight) => <li>{highlight}</li>)}
    </ul>
    <ul class="project__stack" aria-label="Technologies used">
      {stack.map((tech) => <li class="tag">{tech}</li>)}
    </ul>
  </div>
</article>

<style>
  .project {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-xl);
    background: var(--surface-high);
    overflow: hidden;
  }

  .project__art {
    height: 9rem;
    flex-shrink: 0;
    background:
      radial-gradient(
        ellipse 80% 90% at calc(20% + var(--art-shift)) 110%,
        rgba(206, 189, 255, 0.25),
        transparent 60%
      ),
      radial-gradient(
        ellipse 60% 80% at calc(85% - var(--art-shift)) -10%,
        rgba(68, 226, 205, 0.15),
        transparent 55%
      ),
      var(--surface-lowest);
    border-bottom: 1px solid var(--bone-border);
  }

  .project__body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    padding: 2rem;
  }

  .project__name {
    margin-top: 0.6rem;
    font-size: var(--text-headline-md);
  }

  .project__name a {
    color: inherit;
  }

  .project__name a:hover {
    color: var(--primary);
    text-decoration: none;
  }

  .project__description {
    margin-top: 0.9rem;
    color: var(--ink-muted);
  }

  .project__highlights {
    display: grid;
    gap: 0.65rem;
    margin-top: 1.1rem;
    font-size: var(--text-label);
    color: var(--ink-muted);
  }

  .project__highlights li {
    position: relative;
    padding-left: 1.1rem;
  }

  .project__highlights li::before {
    content: '✦';
    position: absolute;
    left: 0;
    top: 0.15em;
    font-size: 0.7em;
    color: var(--primary);
  }

  .project__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 1.5rem;
  }
</style>
