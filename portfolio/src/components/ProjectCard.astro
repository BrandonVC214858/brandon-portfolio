---
import type { CollectionEntry } from 'astro:content';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  entry: CollectionEntry<'projects'>;
  /** Active locale. */
  lang: Lang;
  /** Position in the grid; shifts the decorative gradient art per card. */
  index?: number;
}

const { entry, lang, index = 0 } = Astro.props;
const t = useTranslations(lang);
const { name, role, description, highlights, stack, link } = entry.data;
const artShift = `${(index * 30) % 90}%`;
/* Desynchronizes the relic-glow pulse between sibling cards. */
const pulseDelay = `${index * -2300}ms`;
---

<article
  class="project soul-glow"
  style={`--art-shift: ${artShift}; --pulse-delay: ${pulseDelay}; --reveal-delay: ${index * 90}ms`}
  data-reveal
>
  <div class="project__art" aria-hidden="true"></div>
  <div class="project__body">
    <p class="mono-label">{role}</p>
    <h3 class="project__name">
      {
        link ? (
          <a href={link} rel="noopener noreferrer" target="_blank">
            {name} <span class="project__arrow">↗</span>
          </a>
        ) : (
          name
        )
      }
    </h3>
    <p class="project__description">{description}</p>
    <ul class="project__highlights">
      {highlights.map((highlight) => <li>{highlight}</li>)}
    </ul>
    <ul class="project__stack" aria-label={t('aria.tech')}>
      {stack.map((tech) => <li class="tag">{tech}</li>)}
    </ul>
  </div>
</article>

<style>
  .project {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-xl);
    background: var(--surface-high);
    overflow: hidden;
  }

  /* Ornamental corner brackets, like the relic frames in Hallownest menus. */
  .project::before,
  .project::after {
    content: '';
    position: absolute;
    width: 1.25rem;
    height: 1.25rem;
    border: 0 solid var(--bone-border-strong);
    pointer-events: none;
    z-index: 1;
    transition:
      border-color 0.4s,
      transform 0.4s var(--ease-soul);
  }

  .project::before {
    top: 0.6rem;
    left: 0.6rem;
    border-top-width: 1px;
    border-left-width: 1px;
  }

  .project::after {
    bottom: 0.6rem;
    right: 0.6rem;
    border-bottom-width: 1px;
    border-right-width: 1px;
  }

  .project:hover::before,
  .project:hover::after {
    border-color: rgba(206, 189, 255, 0.5);
    transform: scale(1.1);
  }

  .project__art {
    position: relative;
    height: 9rem;
    flex-shrink: 0;
    background:
      radial-gradient(
        ellipse 80% 90% at calc(20% + var(--art-shift)) 110%,
        rgba(206, 189, 255, 0.25),
        transparent 60%
      ),
      radial-gradient(
        ellipse 60% 80% at calc(85% - var(--art-shift)) -10%,
        rgba(68, 226, 205, 0.15),
        transparent 55%
      ),
      var(--surface-lowest);
    border-bottom: 1px solid var(--bone-border);
    transition: transform 0.6s var(--ease-soul);
  }

  /* Relic glow: a slow soul pulse breathing inside the art panel. */
  .project__art::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 70% 80% at 50% 110%, var(--glow-teal), transparent 65%);
    opacity: 0;
    animation: soul-pulse 7s ease-in-out infinite;
    animation-delay: var(--pulse-delay, 0s);
  }

  .project:hover .project__art {
    transform: scale(1.05);
  }

  .project__body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    padding: 2rem;
  }

  .project__name {
    margin-top: 0.6rem;
    font-size: var(--text-headline-md);
  }

  .project__name a {
    color: inherit;
  }

  .project__name a:hover {
    color: var(--primary);
    text-decoration: none;
  }

  .project__arrow {
    display: inline-block;
    transition: transform 0.3s var(--ease-soul);
  }

  .project__name a:hover .project__arrow {
    transform: translate(0.15em, -0.15em);
  }

  .project__description {
    margin-top: 0.9rem;
    color: var(--ink-muted);
  }

  .project__highlights {
    display: grid;
    gap: 0.65rem;
    margin-top: 1.1rem;
    font-size: var(--text-label);
    color: var(--ink-muted);
  }

  .project__highlights li {
    position: relative;
    padding-left: 1.1rem;
  }

  .project__highlights li::before {
    content: '✦';
    position: absolute;
    left: 0;
    top: 0.15em;
    font-size: 0.7em;
    color: var(--primary);
  }

  .project__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 1.5rem;
  }
</style>
