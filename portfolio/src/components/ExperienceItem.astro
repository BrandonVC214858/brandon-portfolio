---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'experience'>;
  /** Position in the list; staggers the scroll-reveal delay. */
  index?: number;
}

const { entry, index = 0 } = Astro.props;
const { company, role, mode, start, end, sector, bullets, stack } = entry.data;
---

<article class="job" data-reveal style={`--reveal-delay: ${index * 100}ms`}>
  <div class="job__meta">
    <p class="mono-label">{start} — {end}</p>
    <p class="mono-label">{mode} · {sector}</p>
  </div>
  <div class="job__body">
    <h3 class="job__role">{role}</h3>
    <p class="job__company">{company}</p>
    <ul class="job__bullets">
      {bullets.map((bullet) => <li>{bullet}</li>)}
    </ul>
    <ul class="job__stack" aria-label="Technologies used">
      {stack.map((tech) => <li class="tag">{tech}</li>)}
    </ul>
  </div>
</article>

<style>
  .job {
    position: relative;
    display: grid;
    grid-template-columns: 14rem 1fr;
    gap: 1.5rem;
    padding-block: 3rem;
  }

  .job + .job {
    border-top: 1px solid var(--bone-border);
  }

  /* Traveller's path: each job draws its own segment of the timeline plus a
     bench marker, 2rem into the padding added by .experience-list. */
  @media (min-width: 44rem) {
    .job::before {
      content: '';
      position: absolute;
      left: -2rem;
      top: 0;
      bottom: 0;
      width: 1px;
      background: var(--outline-variant);
    }

    .job:last-child::before {
      background: linear-gradient(to bottom, var(--outline-variant) 50%, transparent);
    }

    .job::after {
      content: '';
      position: absolute;
      left: -2rem;
      top: 3.4rem;
      width: 7px;
      height: 7px;
      transform: translateX(-50%) rotate(45deg);
      background: var(--surface);
      border: 1px solid var(--primary);
      transition:
        background-color 0.3s,
        box-shadow 0.3s;
    }

    .job:hover::after {
      background: var(--primary);
      box-shadow: 0 0 12px var(--glow-strong);
    }
  }

  .job__body {
    position: relative;
  }

  /* Nail strike: a glowing slash drawn top-down along the body on hover. */
  .job__body::before {
    content: '';
    position: absolute;
    left: -0.85rem;
    top: 0.25rem;
    bottom: 0.25rem;
    width: 2px;
    background: linear-gradient(to bottom, var(--primary), transparent);
    box-shadow: 0 0 8px var(--glow);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.35s var(--ease-soul);
  }

  .job:hover .job__body::before {
    transform: scaleY(1);
  }

  .job__meta {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .job__role {
    font-size: var(--text-headline-md);
    transition: color 0.3s;
  }

  .job:hover .job__role {
    color: var(--primary);
  }

  .job__company {
    margin-top: 0.4rem;
    font-weight: 600;
    color: var(--primary);
  }

  .job__bullets {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.25rem;
    color: var(--ink-muted);
  }

  .job__bullets li {
    padding-left: 1.25rem;
    position: relative;
  }

  /* Soul spark instead of a default bullet */
  .job__bullets li::before {
    content: '✦';
    position: absolute;
    left: 0;
    top: 0.15em;
    font-size: 0.7em;
    color: var(--primary);
  }

  .job__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  @media (max-width: 44rem) {
    .job {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .job__meta {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.4rem 1.25rem;
    }
  }
</style>
