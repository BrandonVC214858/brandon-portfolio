---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'experience'>;
}

const { company, role, mode, start, end, sector, bullets, stack } = Astro.props.entry.data;
---

<article class="job">
  <div class="job__meta">
    <p class="mono-label">{start} — {end}</p>
    <p class="mono-label">{mode} · {sector}</p>
  </div>
  <div class="job__body">
    <h3 class="job__role">{role}</h3>
    <p class="job__company">{company}</p>
    <ul class="job__bullets">
      {bullets.map((bullet) => <li>{bullet}</li>)}
    </ul>
    <ul class="job__stack" aria-label="Technologies used">
      {stack.map((tech) => <li class="tag">{tech}</li>)}
    </ul>
  </div>
</article>

<style>
  .job {
    display: grid;
    grid-template-columns: 14rem 1fr;
    gap: 1.5rem;
    padding-block: 2.25rem;
  }

  .job + .job {
    border-top: 1px solid var(--line);
  }

  .job__meta {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .job__role {
    font-size: var(--text-lg);
  }

  .job__company {
    margin-top: 0.4rem;
    font-weight: 500;
    color: var(--accent);
  }

  .job__bullets {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.25rem;
    color: var(--chalk);
  }

  .job__bullets li {
    padding-left: 1.25rem;
    position: relative;
  }

  /* Drafting tick instead of a default bullet */
  .job__bullets li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  .job__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  @media (max-width: 44rem) {
    .job {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .job__meta {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.4rem 1.25rem;
    }
  }
</style>
