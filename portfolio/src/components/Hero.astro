---
import { getImage } from 'astro:assets';
import { PROFILE } from '../site.config';
import { useTranslations, type Lang } from '../i18n/ui';
import bgSrc from '../assets/void-bg.png';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

/**
 * Signature element: the hero is a full-viewport "void" — the name floats
 * as a pale inscription over a dark atmospheric background that fades
 * seamlessly into the page ground.
 */
const bgWide = await getImage({ src: bgSrc, format: 'webp', quality: 60 });
const bgNarrow = await getImage({ src: bgSrc, format: 'webp', quality: 55, width: 768 });
---

<section class="hero" id="top">
  <picture class="hero__bg" aria-hidden="true">
    <source media="(max-width: 48rem)" srcset={bgNarrow.src} />
    <img
      src={bgWide.src}
      width={bgWide.attributes.width}
      height={bgWide.attributes.height}
      alt=""
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </picture>
  <div class="hero__veil" aria-hidden="true"></div>

  <!-- Lumaflies: drifting, flickering teal motes from Hallownest's caverns -->
  <div class="hero__lumaflies" aria-hidden="true">
    <span class="hero__lumafly"></span>
    <span class="hero__lumafly"></span>
    <span class="hero__lumafly"></span>
    <span class="hero__lumafly"></span>
    <span class="hero__lumafly"></span>
  </div>

  <div class="container hero__content">
    <p class="hero__badge mono-label">{t('hero.availability')}</p>
    <h1 class="hero__name">Brandon Venegas Cervantes</h1>
    <p class="hero__summary">{t('hero.summary')}</p>
    <p class="mono-label hero__meta">{t('hero.location')} ✦ {t('hero.focus')}</p>

    <div class="hero__actions">
      <a class="hero__cta" href={`mailto:${PROFILE.email}`}>
        <span>{t('hero.cta.email')}</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14" /><path d="m12 5 7 7-7 7" />
        </svg>
      </a>
      <a class="hero__secondary" href={PROFILE.github} rel="noopener noreferrer" target="_blank">
        <span>{t('hero.cta.github')}</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M7 17 17 7" /><path d="M7 7h10v10" />
        </svg>
      </a>
    </div>
  </div>

  <svg
    class="hero__scroll"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="m7 6 5 5 5-5" /><path d="m7 13 5 5 5-5" />
  </svg>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: calc(100svh - 4rem);
    padding-block: var(--space-section);
    overflow: hidden;
  }

  .hero__bg,
  .hero__veil {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: void-drift 38s ease-in-out infinite alternate;
  }

  .hero__veil {
    background: linear-gradient(to bottom, rgba(10, 15, 22, 0.5), rgba(10, 15, 22, 0.97));
  }

  .hero__lumaflies {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero__lumafly {
    position: absolute;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--secondary);
    box-shadow: 0 0 10px 2px var(--glow-teal);
    opacity: 0;
    animation:
      lumafly-drift 18s ease-in-out infinite alternate,
      lumafly-flicker 5s ease-in-out infinite;
  }

  .hero__lumafly:nth-child(1) {
    left: 12%;
    top: 32%;
    animation-duration: 16s, 4.2s;
  }

  .hero__lumafly:nth-child(2) {
    left: 26%;
    top: 68%;
    width: 4px;
    height: 4px;
    animation-duration: 21s, 6.4s;
    animation-delay: -7s, 1.1s;
  }

  .hero__lumafly:nth-child(3) {
    left: 58%;
    top: 22%;
    width: 3px;
    height: 3px;
    animation-duration: 14s, 5.6s;
    animation-delay: -3s, 0.6s;
  }

  .hero__lumafly:nth-child(4) {
    left: 78%;
    top: 56%;
    animation-duration: 22s, 7.2s;
    animation-delay: -11s, 2.3s;
  }

  .hero__lumafly:nth-child(5) {
    left: 88%;
    top: 30%;
    width: 4px;
    height: 4px;
    animation-duration: 17s, 4.8s;
    animation-delay: -5s, 1.7s;
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* Waking sequence: each piece rises from the dark after the curtain lifts.
     Pure CSS, ends fully visible — safe for crawlers and no-JS visitors. */
  .hero__name,
  .hero__summary,
  .hero__meta,
  .hero__actions {
    animation: rise-in 0.8s var(--ease-soul) both;
  }

  .hero__badge {
    padding: 0.4rem 1rem;
    border: 1px solid var(--bone-border-strong);
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.03);
    color: var(--primary);
    animation:
      rise-in 0.8s var(--ease-soul) 0.25s both,
      floating 6s ease-in-out 1.05s infinite;
  }

  .hero__name {
    margin-top: 2rem;
    font-size: var(--text-display);
    line-height: 1.1;
    text-shadow: 0 0 30px var(--glow);
    animation-delay: 0.4s;
  }

  .hero__summary {
    max-width: 52ch;
    margin-top: 1.5rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-headline-md);
    line-height: 1.5;
    color: var(--ink-muted);
    animation-delay: 0.55s;
  }

  .hero__meta {
    margin-top: 1.5rem;
    animation-delay: 0.7s;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 3rem;
    animation-delay: 0.85s;
  }

  .hero__cta,
  .hero__secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 2rem;
    border-radius: var(--radius-lg);
    font-family: var(--font-label);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
    transition:
      border-color 0.3s,
      background-color 0.3s,
      box-shadow 0.4s var(--ease-soul);
  }

  .hero__cta {
    background: var(--surface-high);
    border: 1px solid rgba(73, 69, 82, 0.5);
  }

  .hero__secondary {
    background: transparent;
    border: 1px solid rgba(73, 69, 82, 0.5);
  }

  .hero__cta svg,
  .hero__secondary svg {
    color: var(--primary);
    transition: transform 0.3s;
  }

  .hero__cta:hover,
  .hero__secondary:hover {
    text-decoration: none;
    border-color: rgba(206, 189, 255, 0.5);
    background-color: rgba(206, 189, 255, 0.05);
    box-shadow: 0 0 24px var(--glow);
  }

  .hero__cta:hover svg,
  .hero__secondary:hover svg {
    transform: translateX(0.25rem);
  }

  .hero__scroll {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    translate: -50% 0;
    color: var(--ink);
    opacity: 0.4;
    animation: bounce 2s ease-in-out infinite;
  }

  /* Progressive enhancement: fade the scroll hint out as it leaves the
     viewport. Browsers without scroll-driven animations keep the bounce. */
  @supports (animation-timeline: view()) {
    .hero__scroll {
      animation:
        bounce 2s ease-in-out infinite,
        fade-scroll linear both;
      animation-timeline: auto, view();
    }
  }

  @keyframes fade-scroll {
    to {
      opacity: 0;
    }
  }

  @keyframes void-drift {
    from {
      transform: scale(1);
    }

    to {
      transform: scale(1.07);
    }
  }

  @keyframes lumafly-drift {
    0% {
      transform: translate(0, 0);
    }

    33% {
      transform: translate(2.5rem, -1.75rem);
    }

    66% {
      transform: translate(-1.5rem, -3rem);
    }

    100% {
      transform: translate(1rem, -4.5rem);
    }
  }

  @keyframes lumafly-flicker {
    0%,
    100% {
      opacity: 0.1;
    }

    50% {
      opacity: 0.9;
    }
  }

  @media (max-width: 48rem) {
    /* Fewer motes and a slower zoom on small screens to spare batteries. */
    .hero__lumafly:nth-child(n + 4) {
      display: none;
    }

    .hero__bg img {
      animation-duration: 60s;
    }
  }
</style>
