---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import SectionHeading from './SectionHeading.astro';
import ExperienceItem from './ExperienceItem.astro';
import ProjectCard from './ProjectCard.astro';
import Footer from './Footer.astro';
import { skillGroups } from '../data/skills';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const byOrder = <T extends { data: { order: number } }>(a: T, b: T) =>
  a.data.order - b.data.order;

const experience = (await getCollection('experience', (e) => e.data.lang === lang)).sort(byOrder);
const projects = (await getCollection('projects', (p) => p.data.lang === lang)).sort(byOrder);
---

<BaseLayout lang={lang}>
  <Header lang={lang} />
  <main id="main">
    <Hero lang={lang} />

    <SectionHeading lang={lang} index="02" title={t('section.experience')} id="experience">
      <div class="experience-list">
        {experience.map((entry, i) => <ExperienceItem entry={entry} lang={lang} index={i} />)}
      </div>
    </SectionHeading>

    <SectionHeading lang={lang} index="03" title={t('section.projects')} id="projects">
      <div class="projects-grid">
        {projects.map((entry, i) => <ProjectCard entry={entry} lang={lang} index={i} />)}
      </div>
    </SectionHeading>

    <SectionHeading lang={lang} index="04" title={t('section.skills')} id="skills">
      <dl class="skills-grid">
        {
          skillGroups[lang].map((group, i) => (
            <div class="skills-group soul-glow" data-reveal style={`--reveal-delay: ${i * 90}ms`}>
              <dt class="skills-label mono-label">{group.label}</dt>
              <dd class="skills-items">
                <ul>
                  {group.items.map((item) => (
                    <li class="tag">{item}</li>
                  ))}
                </ul>
              </dd>
            </div>
          ))
        }
      </dl>
    </SectionHeading>

    <SectionHeading lang={lang} index="05" title={t('section.education')} id="education">
      <article class="education" data-reveal>
        <div class="education__dot soul-pulse" aria-hidden="true"></div>
        <p class="mono-label education__dates">{t('edu.dates')}</p>
        <h3 class="education__degree">{t('edu.degree')}</h3>
        <p class="education__school">{t('edu.school')}</p>
        <p class="education__note">{t('edu.note')}</p>
      </article>
    </SectionHeading>
  </main>
  <Footer lang={lang} />
</BaseLayout>

<style>
  /* Makes room for the traveller's-path timeline drawn by each job item
     (see ExperienceItem.astro — markers sit 2rem left of the job edge). */
  @media (min-width: 44rem) {
    .experience-list {
      padding-left: 2.25rem;
    }
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(20rem, 100%), 1fr));
    gap: 2rem;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
    gap: 1.5rem;
    margin: 0;
  }

  .skills-group {
    position: relative;
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    background: var(--surface-container);
  }

  /* Charm notch: the small diamond socket charms clip into in Hollow Knight.
     It lights up when the group is "equipped" (hovered). */
  .skills-group::before {
    content: '';
    position: absolute;
    top: -5px;
    left: 50%;
    width: 9px;
    height: 9px;
    transform: translateX(-50%) rotate(45deg);
    background: var(--surface);
    border: 1px solid var(--secondary);
    animation: twinkle 6s ease-in-out infinite;
    transition:
      background-color 0.3s,
      box-shadow 0.3s;
  }

  .skills-group:hover::before {
    background: var(--secondary);
    box-shadow: 0 0 12px var(--glow-teal);
  }

  .skills-label {
    color: var(--secondary);
    text-shadow: 0 0 14px var(--glow-teal);
  }

  .skills-items {
    margin: 1rem 0 0;
  }

  .skills-items ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .skills-items .tag {
    transition:
      border-color 0.3s,
      color 0.3s;
  }

  .skills-items .tag:hover {
    border-color: rgba(68, 226, 205, 0.4);
    color: var(--secondary);
  }

  .education {
    position: relative;
    max-width: 42rem;
    margin-inline: auto;
    padding-top: 3rem;
    text-align: center;
  }

  .education::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    height: 2.5rem;
    width: 1px;
    background: linear-gradient(to bottom, rgba(73, 69, 82, 0.6), transparent);
    transform-origin: top;
    transition: transform 0.8s var(--ease-soul) 0.3s;
  }

  /* The bench lamppost draws itself down once the entry is revealed. */
  :global(html.js) .education:not(.is-revealed)::before {
    transform: scaleY(0);
  }

  .education__dot {
    position: absolute;
    left: 50%;
    top: 0;
    transform: translateX(-50%);
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 9999px;
    background: var(--surface);
    border: 2px solid var(--primary);
    box-shadow: 0 0 10px var(--primary);
    z-index: 1;
  }

  .education__dates {
    color: var(--primary);
  }

  .education__degree {
    margin-top: 0.75rem;
    font-size: var(--text-headline-md);
  }

  .education__school {
    margin-top: 0.4rem;
    color: var(--ink-muted);
  }

  .education__note {
    max-width: 50ch;
    margin: 1rem auto 0;
    color: var(--ink-muted);
  }
</style>
