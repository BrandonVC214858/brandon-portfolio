---
import { PROFILE } from '../site.config';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const year = new Date().getFullYear();
const contacts = [
  { label: t('contact.email'), value: PROFILE.email, href: `mailto:${PROFILE.email}` },
  { label: t('contact.phone'), value: PROFILE.phone, href: `tel:${PROFILE.phone.replace(/\s/g, '')}` },
  { label: t('contact.github'), value: 'BrandonVC214858', href: PROFILE.github },
  { label: t('contact.linkedin'), value: t('contact.linkedinValue'), href: PROFILE.linkedin },
];
---

<footer class="footer" id="contact">
  <div class="container">
    <div class="footer__panel soul-glow" data-reveal>
      <svg
        class="footer__ornament"
        width="120"
        height="120"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect x="2" y="4" width="20" height="16" rx="2" />
        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
      </svg>

      <p class="mono-label">✦ {t('entry')} 06 · {t('nav.contact')}</p>
      <h2 class="footer__title">{t('footer.title')}</h2>
      <p class="footer__note">{t('footer.note')}</p>

      <ul class="footer__contacts">
        {
          contacts.map((contact) => (
            <li class="footer__cell">
              <span class="mono-label">{contact.label}</span>
              <a
                class="footer__link"
                href={contact.href}
                rel={contact.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                target={contact.href.startsWith('http') ? '_blank' : undefined}
              >
                {contact.value}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <p class="footer__legal mono-label">
      © {year} {PROFILE.name} <span class="twinkle" aria-hidden="true">✦</span> {t('footer.builtWith')}
    </p>
  </div>
</footer>

<style>
  .footer {
    padding-block: var(--space-section);
  }

  .footer__panel {
    position: relative;
    /* New stacking context so the mist (z-index: -1) stays inside the panel. */
    isolation: isolate;
    padding: clamp(3rem, 8vw, 6rem);
    border-radius: var(--radius-2xl);
    background: var(--surface-container);
    overflow: hidden;
  }

  /* Interior mist drifting through the heart of the void. */
  .footer__panel::before {
    content: '';
    position: absolute;
    inset: -20%;
    z-index: -1;
    background: radial-gradient(ellipse 60% 50% at 30% 80%, var(--glow-soft), transparent 70%);
    animation: footer-mist 90s ease-in-out infinite alternate;
    pointer-events: none;
  }

  /* Decorative envelope emerging from the mist */
  .footer__ornament {
    position: absolute;
    top: 2rem;
    right: 2rem;
    color: var(--primary);
    opacity: 0.1;
    pointer-events: none;
    animation: floating 8s ease-in-out infinite;
    transition: opacity 0.4s;
  }

  .footer__panel:hover .footer__ornament {
    opacity: 0.18;
  }

  .footer__title {
    margin-top: 1rem;
    font-size: var(--text-headline-lg);
  }

  .footer__note {
    max-width: 48ch;
    margin-top: 1rem;
    color: var(--ink-muted);
  }

  .footer__contacts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(12rem, 100%), 1fr));
    gap: 1.5rem;
    margin-top: 3rem;
  }

  .footer__cell {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .footer__link {
    position: relative;
    width: fit-content;
    font-family: var(--font-label);
    font-size: var(--text-label);
    color: var(--ink);
    overflow-wrap: anywhere;
    transition: color 0.3s;
  }

  /* Dream-nail underline: a pale cut drawn left to right. */
  .footer__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.25rem;
    height: 1px;
    background: var(--primary);
    box-shadow: 0 0 8px var(--glow-strong);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease-soul);
  }

  .footer__link:hover::after,
  .footer__link:focus-visible::after {
    transform: scaleX(1);
  }

  .footer__link:hover {
    color: var(--primary);
    text-decoration: none;
  }

  .footer__legal {
    margin-top: 3rem;
    color: var(--outline);
    text-align: center;
  }

  @keyframes footer-mist {
    from {
      transform: translateX(-6%);
    }

    to {
      transform: translateX(6%);
    }
  }
</style>
