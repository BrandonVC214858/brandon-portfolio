---
interface Props {
  /** Codex entry number rendered in the eyebrow, e.g. "02". */
  index: string;
  /** Section title. */
  title: string;
  /** Anchor id for in-page navigation. */
  id: string;
}

const { index, title, id } = Astro.props;
---

<section class="section" id={id}>
  <div class="container">
    <header class="section__head" data-reveal>
      <p class="mono-label"><span class="twinkle" aria-hidden="true">✦</span> Entry {index}</p>
      <h2 class="section__title">{title}</h2>
      <div class="artifact-divider section__divider" aria-hidden="true"></div>
    </header>
    <slot />
  </div>
</section>

<style>
  .section {
    padding-block: var(--space-section);
    /* Skip rendering off-screen sections; the estimate keeps anchors stable. */
    content-visibility: auto;
    contain-intrinsic-size: auto 600px;
  }

  .section__head {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .section__title {
    margin-top: 0.75rem;
    font-size: var(--text-headline-lg);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--primary);
  }

  .section__divider {
    width: min(16rem, 50%);
    margin-top: 1.25rem;
  }
</style>
