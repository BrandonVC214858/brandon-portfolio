---
import LangToggle from './LangToggle.astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const links = [
  { href: '#experience', label: t('nav.experience') },
  { href: '#projects', label: t('nav.projects') },
  { href: '#skills', label: t('nav.skills') },
  { href: '#contact', label: t('nav.contact') },
];
---

<header class="header">
  <div class="container header__inner">
    <a class="header__mark" href="#top" aria-label={t('nav.backToTop')}>BVC</a>
    <nav aria-label={t('nav.aria')}>
      <ul class="header__nav">
        {
          links.map((link) => (
            <li>
              <a class="header__link" href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <LangToggle lang={lang} />
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid rgba(73, 69, 82, 0.2);
    background: rgba(10, 15, 22, 0.8);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.85rem;
  }

  .header__mark {
    font-family: var(--font-display);
    font-size: var(--text-headline-md);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .header__mark {
    transition:
      color 0.3s,
      text-shadow 0.3s;
  }

  .header__mark:hover {
    text-decoration: none;
    color: var(--primary);
    text-shadow: 0 0 12px var(--glow-strong);
  }

  .header__nav {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(0.75rem, 2.5vw, 1.75rem);
  }

  .header__link {
    position: relative;
    font-family: var(--font-label);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
    transition: color 0.3s;
  }

  /* Lumafly trail: a glowing teal line lighting the way to the section. */
  .header__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.35rem;
    height: 1px;
    background: var(--secondary);
    box-shadow: 0 0 8px var(--glow-teal);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease-soul);
  }

  .header__link:hover::after,
  .header__link:focus-visible::after {
    transform: scaleX(1);
  }

  .header__link:hover {
    color: var(--primary);
    text-decoration: none;
  }

  @media (max-width: 30rem) {
    .header__link {
      font-size: var(--text-xs);
      letter-spacing: 0.06em;
    }
  }
</style>
